include ../range/mixin.pug

mixin card(type)
  section.card( class=`is-${type}` id=(type === 'h' ? 'hue-card' : undefined) )

    if type === 'l'
      h2.card_title Lightness
        button.card_peak( type="button" ) Peak
      .card_number
        +field('L', 'l', {
          type: 'text',
          role: 'spinbutton',
          'aria-valuemin': 0,
          'aria-valuemax': 1,
          pattern: '^[0-9+\\/*.\\-]+$',
          inputmode: 'decimal',
          step: L_STEP
        })
      .card_chart
        .card_size
          +chart('h', 'c', 'l')
      +range('l', 1, L_STEP, 70)

    else if type === 'c'
      h2.card_title Chroma
        button.card_peak( type="button" ) Maximize
      .card_peak_bounds
        span.card_hue_list_label H
        input.card_peak_hmin(
          type="number"
          min="0"
          max=H_MAX
          step=0.01
          placeholder="min"
        )
        | –
        input.card_peak_hmax(
          type="number"
          min="0"
          max=H_MAX
          step=0.01
          placeholder="max"
        )
      .card_number
        +field('C', 'c', {
          type: 'text',
          role: 'spinbutton',
          pattern: '^[0-9+\\/*.\\-]+$',
          'aria-valuemin': 0,
          inputmode: 'decimal',
          step: C_STEP
        })
      .card_chart
        .card_size
          +chart('l', 'c', 'h')
      +range('c', C_MAX, C_STEP, LCH ? 39 : 0.1)

    else if type === 'h'
      h2.card_title Hue
      .card_number
        +field('H', 'h', {
          type: 'text',
          role: 'spinbutton',
          pattern: '^[0-9+\\/*.\\-]+$',
          'aria-valuemin': 0,
          'aria-valuemax': H_MAX,
          inputmode: 'decimal',
          step: H_STEP
        })
      .card_chart
        .card_size
          +chart('c', 'l', 'h')
      +range('h', H_MAX, H_STEP, 286)

    else if type === 'list'
      h2.card_title Color List
        button.card_peak.card_hue_list_btn( type="button" ) List (slow!)
      .card_hue_list
        .card_hue_list_row
          span.card_hue_list_label L
          input.card_hue_lmin(
            type="number"
            min="0"
            max="1"
            step=L_STEP
            placeholder="min"
          )
          | –
          input.card_hue_lmax(
            type="number"
            min="0"
            max="1"
            step=L_STEP
            placeholder="max"
          )
        .card_hue_list_row
          span.card_hue_list_label C
          input.card_hue_cmin(
            type="number"
            min="0"
            max=C_MAX
            step=C_STEP
            placeholder="min"
          )
          | –
          input.card_hue_cmax(
            type="number"
            min="0"
            max=C_MAX
            step=C_STEP
            placeholder="max"
          )
        .card_hue_list_row
          span.card_hue_list_label H
          input.card_hue_hmin(
            type="number"
            min="0"
            max=H_MAX
            step=H_STEP
            placeholder="min"
          )
          | –
          input.card_hue_hmax(
            type="number"
            min="0"
            max=H_MAX
            step=H_STEP
            placeholder="max"
          )
        .card_hue_list_results
          ul.card_hue_list_output
          p.card_hue_list_overflow_note Copy to clipboard to get full list
          button.card_peak.card_hue_list_copy( type="button" )
            span.card_hue_list_copy_clipboard
              include ./clipboard.svg
            span.card_hue_list_copy_check
              include ./check.svg
            | Copy

    else if type === 'a'
      h2.card_title Alpha
      .card_number
        +field('Alpha', 'a', {
          type: 'text',
          role: 'spinbutton',
          pattern: '^[0-9+\\/*.\\-]+$',
          'aria-valuemin': 0,
          'aria-valuemax': ALPHA_MAX,
          value: ALPHA_MAX,
          step: ALPHA_STEP,
          inputmode: 'decimal'
        })
      +range('a', ALPHA_MAX, ALPHA_STEP, 100)

    else if type === '3d'
      h2.card_title 3D
      include ../minimodel/index.pug
